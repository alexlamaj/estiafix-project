<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="estiafix.controller.MyReportsController" styleClass="screen">

    <top>
        <HBox styleClass="header" alignment="CENTER_LEFT" spacing="28">
            <HBox alignment="CENTER_LEFT" spacing="9">
                <Region styleClass="logo-tag" />
                <Label text="EstiaFix" styleClass="brand-name" />
            </HBox>
            <HBox spacing="24">
                <Button text="Αρχική" onAction="#onHome" styleClass="tab" />
                <Button text="Οι δηλώσεις μου" styleClass="tab-active" />
            </HBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Προβολή Τεχνικού" onAction="#onTechnician" styleClass="link-button" />
        </HBox>
    </top>

    <center>
        <VBox styleClass="page" spacing="16">

            <HBox alignment="BOTTOM_LEFT" spacing="24">
                <VBox spacing="6">
                    <Label text="Οι δηλώσεις μου" styleClass="screen-title" />
                    <Label text="Όσες έκανες και όσες παρακολουθείς." styleClass="lead" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button text="Νέα δήλωση βλάβης" onAction="#onNewReport" styleClass="primary-button" />
            </HBox>

            <Label fx:id="messageLabel" styleClass="info-banner" wrapText="true" maxWidth="Infinity" />

            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="Κατάσταση" styleClass="field-label" />
                <ComboBox fx:id="statusFilter" prefWidth="190" />
                <TextField fx:id="searchField" prefWidth="300" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="countLabel" styleClass="hint" minWidth="-Infinity" />
            </HBox>

            <TableView fx:id="table" VBox.vgrow="ALWAYS">

                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN" />
                </columnResizePolicy>

                <columns>
                    <TableColumn fx:id="codeColumn" text="Αριθμός" prefWidth="130" styleClass="code-column" />
                    <TableColumn fx:id="categoryColumn" text="Κατηγορία" prefWidth="200" />
                    <TableColumn fx:id="locationColumn" text="Δωμάτιο" prefWidth="120" />
                    <TableColumn fx:id="dateColumn" text="Ημερομηνία" prefWidth="180" />
                    <TableColumn fx:id="statusColumn" text="Κατάσταση" prefWidth="200" />
                </columns>

            </TableView>

            <HBox spacing="16" alignment="TOP_LEFT">
                <Label fx:id="detailsLabel" styleClass="details" wrapText="true" maxWidth="Infinity" />
                <Button fx:id="cancelButton" text="Ακύρωση Δήλωσης" onAction="#onCancelReport" styleClass="danger-button" minWidth="-Infinity" />
            </HBox>

        </VBox>
    </center>

</BorderPane>
