<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="estiafix.controller.ReportFormController" styleClass="screen">

    <fx:define>
        <ToggleGroup fx:id="accessGroup" />
    </fx:define>

    <top>
        <VBox>
            <HBox styleClass="header" alignment="CENTER_LEFT" spacing="20">
                <HBox alignment="CENTER_LEFT" spacing="9">
                    <Region styleClass="logo-tag" />
                    <Label text="EstiaFix" styleClass="brand-name" />
                </HBox>
                <Region styleClass="vrule" />
                <VBox alignment="CENTER_LEFT">
                    <Label text="Νέα δήλωση βλάβης" styleClass="flow-title" />
                    <Label text="Βήμα 2 από 2: στοιχεία" styleClass="flow-step" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button text="Πίσω" onAction="#onBack" styleClass="link-button" />
            </HBox>
            <HBox styleClass="progress">
                <Region styleClass="progress-done" HBox.hgrow="ALWAYS" />
                <Region styleClass="progress-done" HBox.hgrow="ALWAYS" />
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="form-scroll">
            <VBox styleClass="page">
                <VBox spacing="16" maxWidth="760">

                    <Label text="Στοιχεία βλάβης" styleClass="screen-title" />

                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Label fx:id="categoryLabel" styleClass="category-line" />
                        <Button text="Αλλαγή" onAction="#onBack" styleClass="link-button" />
                    </HBox>

                    <Label fx:id="formError" styleClass="error-banner" wrapText="true" maxWidth="Infinity" />

                    <VBox styleClass="panel">

                        <VBox styleClass="form-section">
                            <Label text="Πού είναι η βλάβη" styleClass="section-title" />
                            <HBox spacing="16">
                                <VBox spacing="5">
                                    <Label text="Κτήριο" styleClass="field-label" />
                                    <ComboBox fx:id="buildingBox" prefWidth="150" promptText="Διάλεξε" />
                                    <Label fx:id="buildingError" styleClass="error-label" wrapText="true" />
                                </VBox>
                                <VBox spacing="5">
                                    <Label text="Δωμάτιο" styleClass="field-label" />
                                    <TextField fx:id="roomField" prefWidth="150" promptText="π.χ. 214" />
                                    <Label fx:id="roomError" styleClass="error-label" wrapText="true" maxWidth="420" />
                                </VBox>
                            </HBox>
                        </VBox>

                        <VBox styleClass="form-section">
                            <Label text="Τι ακριβώς συμβαίνει" styleClass="section-title" />
                            <TextArea fx:id="descriptionArea" wrapText="true" prefRowCount="4"
                                      promptText="π.χ. Το καλοριφέρ είναι κρύο και η βαλβίδα δεν γυρίζει" />
                            <HBox spacing="12" alignment="CENTER_LEFT">
                                <Label fx:id="descriptionError" styleClass="error-label" wrapText="true" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="charCountLabel" styleClass="hint" minWidth="-Infinity" />
                            </HBox>
                            <CheckBox fx:id="urgentCheck" text="Είναι επείγον: τρέχει νερό, δεν έχω ρεύμα ή θέρμανση" />
                        </VBox>

                        <VBox styleClass="form-section">
                            <Label text="Πρόσβαση στο δωμάτιο" styleClass="section-title" />
                            <RadioButton fx:id="withoutMeRadio" text="Μπορεί να μπει ο τεχνικός χωρίς εμένα"
                                         toggleGroup="$accessGroup" />
                            <CheckBox fx:id="consentCheck" styleClass="indented"
                                      text="Συμφωνώ να μπει ο τεχνικός στο δωμάτιό μου όταν λείπω" />
                            <Label fx:id="consentError" styleClass="error-label" wrapText="true" />
                            <RadioButton fx:id="withMeRadio" text="Μόνο όταν είμαι εκεί"
                                         toggleGroup="$accessGroup" />
                            <HBox fx:id="hoursBox" spacing="10" alignment="CENTER_LEFT" styleClass="indented">
                                <Label text="από" />
                                <ComboBox fx:id="fromBox" prefWidth="110" />
                                <Label text="έως" />
                                <ComboBox fx:id="toBox" prefWidth="110" />
                            </HBox>
                            <Label fx:id="hoursError" styleClass="error-label" wrapText="true" />
                            <Label fx:id="accessError" styleClass="error-label" wrapText="true" />
                        </VBox>

                        <VBox styleClass="form-section-last">
                            <Label text="Τηλέφωνο επικοινωνίας" styleClass="section-title" />
                            <TextField fx:id="phoneField" prefWidth="240" maxWidth="240" />
                            <Label text="Το βλέπει μόνο το τεχνικό προσωπικό." styleClass="hint" />
                            <Label fx:id="phoneError" styleClass="error-label" wrapText="true" />
                        </VBox>

                    </VBox>

                    <HBox spacing="12">
                        <Button text="Καταχώριση δήλωσης" onAction="#onSubmit" styleClass="big-primary-button" defaultButton="true" />
                        <Button text="Πίσω" onAction="#onBack" styleClass="secondary-button" cancelButton="true" />
                    </HBox>

                </VBox>
            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
