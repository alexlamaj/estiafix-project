<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.ListView?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="estiafix.controller.HomeController" styleClass="screen">

    <top>
        <HBox styleClass="header" alignment="CENTER_LEFT" spacing="28">
            <HBox alignment="CENTER_LEFT" spacing="9">
                <Region styleClass="logo-tag" />
                <Label text="EstiaFix" styleClass="brand-name" />
            </HBox>
            <HBox spacing="24">
                <Button text="Αρχική" styleClass="tab-active" />
                <Button text="Οι δηλώσεις μου" onAction="#onMyReports" styleClass="tab" />
            </HBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Προβολή Τεχνικού" onAction="#onTechnician" styleClass="link-button" />
        </HBox>
    </top>

    <center>
        <VBox styleClass="page" spacing="32">

            <VBox spacing="22">
                <VBox spacing="6">
                    <Label fx:id="greetingLabel" styleClass="hello" />
                    <Label fx:id="roomLabel" styleClass="room" />
                </VBox>
                <Button text="Νέα δήλωση βλάβης" onAction="#onNewReport" styleClass="big-primary-button" />
            </VBox>

            <Label fx:id="updatesLabel" styleClass="info-banner" wrapText="true" maxWidth="Infinity" />

            <HBox spacing="24" VBox.vgrow="ALWAYS">
                <VBox styleClass="panel" HBox.hgrow="ALWAYS" prefWidth="400">
                    <Label text="Οι ανοιχτές δηλώσεις σου" styleClass="panel-title" maxWidth="Infinity" />
                    <ListView fx:id="myOpenList" styleClass="report-list" VBox.vgrow="ALWAYS" />
                </VBox>
                <VBox styleClass="panel" HBox.hgrow="ALWAYS" prefWidth="400">
                    <Label fx:id="buildingTitle" styleClass="panel-title" maxWidth="Infinity" />
                    <ListView fx:id="buildingIssuesList" styleClass="report-list" VBox.vgrow="ALWAYS" />
                </VBox>
            </HBox>

        </VBox>
    </center>

</BorderPane>