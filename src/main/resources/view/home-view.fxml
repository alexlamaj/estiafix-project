<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.ListView?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="estiafix.controller.HomeController" styleClass="screen">

    <top>
        <HBox styleClass="header" alignment="CENTER_LEFT" spacing="12">
            <Label text="EstiaFix" styleClass="app-title"/>
            <Label text="Αναφορά Βλαβών Φοιτικής Εστίας" styleClass="app-subtitle"/>
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Οι Δηλώσεις Μου" onAction="#onMyReports" styleClass="nav-button" />
        </HBox>
    </top>

    <center>
        <VBox spacing="20" styleClass="content">

            <Label fx:id="greetingLabel" styleClass="screen-title" wrapText="true" />
            <Button text="+ Νέα Δήλωση Βλάβης" onAction="#onNewReport" styleClass="primary-button" defaultButton="true" />

            <HBox spacing="24" VBox.vgrow="ALWAYS">
                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <Label text="Οι ανοιχτές δηλώσεις μου" styleClass="section-title" />
                    <ListView fx:id="myOpenList" VBox.vgrow="ALWAYS" />
                </VBox>
                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <Label fx:id="buildingTitle" styleClass="section-title" />
                    <ListView fx:id="buildingIssuesList" VBox.vgrow="ALWAYS" />
                </VBox>
            </HBox>

        </VBox>
    </center>

</BorderPane>