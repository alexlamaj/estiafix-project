<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="estiafix.controller.CategoryController" styleClass="screen">

    <top>
        <HBox styleClass="header" alignment="CENTER_LEFT" spacing="12">
            <Button text="Πίσω" onAction="#onBack" styleClass="nav-button"/>
            <Label text="EstiaFix" styleClass="app-title" />
            <Region HBox.hgrow="ALWAYS" />
        </HBox>
    </top>

    <center>
        <VBox spacing="18" styleClass="content">

            <Label text="Τι χάλασε;" styleClass="screen-title" />
            <Label text="Διάλεξε κατηγορία. Θα ελέγξουμε αν η βλάβη έχει ήδη δηλωθεί στο κτήριο σου." styleClass="hint" wrapText="true" />

            <TilePane hgap="16" vgap="16" prefColumns="3">

                <Button text="θέρμανση" userData="HEATING" onAction="#onCategorySelected" styleClass="category-button" />
                <Button text="Υδραυλικά" userData="PLUMBING" onAction="#onCategorySelected" styleClass="category-button" />
                <Button text="Ηλεκτρολογικά" userData="ELECTRICAL" onAction="#onCategorySelected" styleClass="category-button" />
                <Button text="Ίντερνετ" userData="INTERNET" onAction="#onCategorySelected" styleClass="category-button" />
                <Button text="Πόρτες και Έπιπλα" userData="DOORS_FURNITURE" onAction="#onCategorySelected" styleClass="category-button" />
                <Button text="Άλλο" userData="OTHER" onAction="#onCategorySelected" styleClass="category-button" />

            </TilePane>

            <VBox fx:id="duplicateCard" spacing="12" styleClass="warning-card">
                <Label text="Υπάρχει ήδη δήλωση" styleClass="section-title" />
                <Label fx:id="duplicateText" wrapText="true" />
                <HBox spacing="12">
                    <Button text="Με αφορά και εμένα" onAction="#onFollow" styleClass="primary-button" />
                    <Button text="Είναι κάτι άλλο, συνέχεια" onAction="#onSomethingElse" styleClass="secondary-button" />
                </HBox>
            </VBox>

        </VBox>
    </center>

</BorderPane>
