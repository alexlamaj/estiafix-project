<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="estiafix.controller.ConfirmationController" styleClass="screen">

    <top>
        <HBox styleClass="header" alignment="CENTER_LEFT" spacing="12">
            <Label text="EstiaFix" styleClass="app-title"/>
            <Label text="Αναφορά Βλαβών Φοιτικής Εστίας" styleClass="app-subtitle"/>
            <Region HBox.hgrow="ALWAYS" />
        </HBox>
    </top>

    <center>
        <VBox spacing="16" styleClass="content" maxWidth="760">

            <Label fx:id="titleLabel" styleClass="success-title" wrapText="true" />
            <Label fx:id="summaryLabel" styleClass="summary-card" wrapText="true" maxWidth="Infinity" />
            <Label text="Τι γίνεται τώρα" styleClass="section-title" />
            <Label fx:id="nextStepsLabel" wrapText="true" />

            <HBox spacing="12">
                <Button text="Οι δηλώσεις μου" onAction="#onMyReports" styleClass="primary-button" defaultButton="true" />
                <Button text="Αρχική" onAction="#onHome" styleClass="secondary-button" />
            </HBox>

        </VBox>
    </center>

</BorderPane>
