<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="estiafix.controller.ConfirmationController" styleClass="screen">

    <top>
        <HBox styleClass="header" alignment="CENTER_LEFT" spacing="28">
            <HBox alignment="CENTER_LEFT" spacing="9">
                <Region styleClass="logo-tag" />
                <Label text="EstiaFix" styleClass="brand-name" />
            </HBox>
            <HBox spacing="24">
                <Button text="Αρχική" onAction="#onHome" styleClass="tab" />
                <Button text="Οι δηλώσεις μου" onAction="#onMyReports" styleClass="tab" />
            </HBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Προβολή Τεχνικού" onAction="#onTechnician" styleClass="link-button" />
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="form-scroll">
            <VBox styleClass="page">

                <VBox styleClass="slip" spacing="12" maxWidth="640">

                    <Label fx:id="titleLabel" styleClass="ok-title" wrapText="true" />
                    <HBox spacing="18" alignment="CENTER_LEFT">
                        <Label fx:id="codeLabel" styleClass="big-code" />
                        <Label fx:id="statusTag" styleClass="tag" />
                    </HBox>
                    <Label text="Με αυτόν τον αριθμό τη βρίσκεις στις δηλώσεις σου." styleClass="hint" />

                    <Region styleClass="rule" />
                    <Label fx:id="summaryLabel" styleClass="summary" wrapText="true" />
                    <Region styleClass="rule" />

                    <Label text="Τι γίνεται τώρα" styleClass="section-title" />
                    <Label fx:id="nextStepsLabel" styleClass="steps" wrapText="true" />

                    <HBox spacing="12">
                        <Button text="Οι δηλώσεις μου" onAction="#onMyReports" styleClass="primary-button" defaultButton="true" />
                        <Button text="Αρχική" onAction="#onHome" styleClass="secondary-button" />
                    </HBox>

                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
